# Skopiuj ten plik do .env i uzupełnij realnymi wartościami.
# .env jest ignorowany przez git (patrz .gitignore) — NIE commituj sekretów.
# Wczytanie do powłoki:  set -a; source .env; set +a

# ── Frontend (Vite) ──────────────────────────────────────────────
# Hasło do logowania w aplikacji
VITE_AUTH_PASSWORD=your_password_here
# Ścieżka bazowa buildu (jak w deploy.yml), np. /invest/
VITE_BASE_PATH=/invest/
# Konfiguracja Supabase dla frontendu (klucz anon, publiczny)
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://twoj-projekt.supabase.co
# Klucz service_role (NIE anon) — używany przez skrypty backup/update/restore
SUPABASE_SERVICE_KEY=your_service_role_key
# Token dostępowy do deployu Edge Functions (deploy.yml)
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# ── Google Drive (backup_to_drive.py) ────────────────────────────
# Dla zwykłego prywatnego Google Drive użyj OAuth poniżej.
# GOOGLE_SERVICE_ACCOUNT_JSON działa tylko sensownie z Google Workspace Shared Drive
# albo z delegacją domenową; samo udostępnienie folderu z My Drive nie wystarcza.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"backup-bot@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# Preferowane dla prywatnego konta Google / zwykłego My Drive.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# ── Opcjonalne (fallback cen w update_portfolio.py) ──────────────
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_API_KEY_2=
